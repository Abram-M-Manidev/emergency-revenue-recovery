# Production overlay variables — copy to `.env` at the repository root on the
# deployment host. Compose reads that file automatically.
#
# This file configures the *compose stack* (TLS hostname, database password,
# backup cadence). The API's own runtime settings live in `apps/api/.env`,
# from `apps/api/.env.example` — both are required, and neither belongs in
# git.
#
#   cp docker/compose.env.production.example .env
#   cp apps/api/.env.example apps/api/.env      # then edit for production
#
# Nothing here has a safe default. `docker-compose.prod.yml` uses
# `${VAR:?message}` for the three that must never fall back, so the stack
# refuses to start rather than coming up misconfigured.

# --- Public identity -------------------------------------------------------
# The DNS name browsers and Vapi reach. Must already resolve to this host's
# public IP before first boot: Caddy proves control of the name over port 80
# to obtain its certificate, so a name that does not resolve yet fails
# issuance in a loop.
#
# This is also the stable Vapi webhook host. Replacing an ngrok tunnel with
# it is the point of the whole production stack — see docs/DEPLOYMENT.md.
ERRS_DOMAIN=essr.example.com

# Where Let's Encrypt sends certificate-expiry warnings if renewal ever
# fails. A real, monitored mailbox — this is the only warning you get before
# TLS lapses.
ERRS_TLS_EMAIL=ops@example.com

# --- Database --------------------------------------------------------------
POSTGRES_USER=errs
POSTGRES_DB=errs

# Generate, do not invent:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Postgres is never published to the host in production, so this is not
# internet-facing — but it is still the credential protecting every tenant's
# call history, and it appears in DATABASE_URL in `apps/api/.env`.
POSTGRES_PASSWORD=

# Per-worker connection pool. The API runs 4 uvicorn workers, so the ceiling
# is (POOL_SIZE + MAX_OVERFLOW) x 4 and must stay under Postgres's
# max_connections (100 by default). 5+5 gives 40, leaving headroom for
# psql, the backup job, and migrations.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# --- Frontend --------------------------------------------------------------
# Same-origin through Caddy, so there is no second hostname and no
# cross-origin request for CORS to allow. Inlined at image build time by
# Next.js, which is why it is set here rather than only at runtime.
NEXT_PUBLIC_API_BASE_URL=https://essr.example.com/api/v1

# --- Backups ---------------------------------------------------------------
# Seconds between dumps. 86400 is nightly. The schedule is relative to
# container start, not wall-clock — restart the stack at a quiet hour if the
# exact time matters.
BACKUP_INTERVAL_SECONDS=86400

# Dumps older than this are pruned on every run. 14 days of a pilot's dumps
# is a few tens of megabytes; raise it before you raise the disk.
#
# These live in the `postgres_backups` Docker volume, which is on the same
# host as the database — so it survives a container rebuild but NOT the loss
# of the host. Copying dumps off-host is a Phase 3 item and is called out as
# such in docs/RUNBOOK.md rather than pretended away.
BACKUP_RETENTION_DAYS=14
