# Production overlay variables — copy to `.env` at the repository root on the
# deployment host. Compose reads that file automatically.
#
# This file configures the *compose stack* (TLS hostname, database password,
# backup cadence). The API's own runtime settings live in `apps/api/.env`,
# from `apps/api/.env.example` — both are required, and neither belongs in
# git.
#
#   cp docker/compose.env.production.example .env
#   cp apps/api/.env.example apps/api/.env      # then edit for production
#
# Nothing here has a safe default. `docker-compose.prod.yml` uses
# `${VAR:?message}` for the three that must never fall back, so the stack
# refuses to start rather than coming up misconfigured.

# --- Public identity -------------------------------------------------------
# The DNS name browsers and Vapi reach. Must already resolve to this host's
# public IP before first boot: Caddy proves control of the name over port 80
# to obtain its certificate, so a name that does not resolve yet fails
# issuance in a loop.
#
# This is also the stable Vapi webhook host. Replacing an ngrok tunnel with
# it is the point of the whole production stack — see docs/DEPLOYMENT.md.
ERRS_DOMAIN=essr.example.com

# Where Let's Encrypt sends certificate-expiry warnings if renewal ever
# fails. A real, monitored mailbox — this is the only warning you get before
# TLS lapses.
ERRS_TLS_EMAIL=ops@example.com

# --- Database --------------------------------------------------------------
POSTGRES_USER=errs
POSTGRES_DB=errs

# Generate, do not invent:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Postgres is never published to the host in production, so this is not
# internet-facing — but it is still the credential protecting every tenant's
# call history, and it appears in DATABASE_URL in `apps/api/.env`.
POSTGRES_PASSWORD=

# Per-worker connection pool. The API runs 4 uvicorn workers, so the ceiling
# is (POOL_SIZE + MAX_OVERFLOW) x 4 and must stay under Postgres's
# max_connections (100 by default). 5+5 gives 40, leaving headroom for
# psql, the backup job, and migrations.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# --- Frontend --------------------------------------------------------------
# Same-origin through Caddy, so there is no second hostname and no
# cross-origin request for CORS to allow. Inlined into the JavaScript bundle
# at image BUILD time (docker-compose.prod.yml passes it as a build arg);
# changing it later needs `up -d --build frontend`, not just a restart.
#
# Leave it unset: it defaults to https://${ERRS_DOMAIN}/api/v1, so it can
# never disagree with the TLS hostname. Set it only if the API is genuinely
# served from a different origin. Never point it at localhost — the bundle
# runs in each visitor's browser, where localhost is their own machine.
# NEXT_PUBLIC_API_BASE_URL=https://essr.example.com/api/v1

# --- Backups ---------------------------------------------------------------
# Full detail: docs/RUNBOOK.md "Backups". Every dump is validated, uploaded to
# Backblaze B2, read back and sha256-checked before it counts; the local copy
# is kept only as a fast-restore convenience.

# Seconds between dumps. 86400 is nightly. The schedule is relative to
# container start, not wall-clock — restart the backup service at a quiet
# hour if the exact time matters.
BACKUP_INTERVAL_SECONDS=86400

# After a failed cycle (B2 unreachable, say), retry the pending upload this
# often instead of waiting a whole interval. No new dump is taken while the
# last one is still recent.
BACKUP_RETRY_SECONDS=3600

# Local copies (the `postgres_backups` volume, on this host) older than this
# are pruned — but ONLY once their off-site copy is verified. A dump that
# never reached B2 is kept however old it is.
BACKUP_RETENTION_DAYS=7

# --- Off-site: Backblaze B2 (required in production) -------------------------
# A dedicated application key restricted to the one bucket. Minimum
# capabilities: listBuckets, listFiles, readFiles, writeFiles,
# readFileRetentions, writeFileRetentions. It must NOT have deleteFiles,
# bypassGovernance or writeBucketRetentions — see docs/RUNBOOK.md for the
# exact `b2 key create` command. Verify with:
#   essr exec backup errs-offsite check
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=ERRS-production-backups

# Leave empty: discovered from the key (b2_authorize_account). Set it only to
# pin the endpoint, e.g. https://s3.us-west-004.backblazeb2.com
B2_S3_ENDPOINT=

# Object key prefix inside the bucket: <prefix>/<db>/<yyyy>/<mm>/errs-<utc>.dump
BACKUP_REMOTE_PREFIX=errs/postgres

# Every upload is locked for this many days (Object Lock, GOVERNANCE mode).
# Nothing — not this key, not a compromised host — can delete or overwrite a
# backup inside that window. Expiry afterwards is a B2 lifecycle rule
# (runbook), never the application.
BACKUP_OBJECT_LOCK_MODE=GOVERNANCE
BACKUP_OBJECT_LOCK_DAYS=30

# Optional dead-man's switch (e.g. a healthchecks.io check URL): pinged after
# every verified off-site backup. It is the only alert that still fires when
# the whole VM is gone. Treated as a secret; never logged.
BACKUP_HEARTBEAT_URL=
