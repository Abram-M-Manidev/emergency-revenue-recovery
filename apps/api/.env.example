# Copy to .env and fill in real values. Never commit the real .env file.

# --- Application ---
APP_NAME="Emergency Revenue Recovery System"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=changeme-generate-a-real-64-byte-secret-for-local-dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database ---
DATABASE_URL=postgresql+asyncpg://errs:errs@localhost:5432/errs
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- Third-party providers ---
OPENAI_API_KEY=
# VAPI_API_KEY/TWILIO_*: only needed by whoever manually configures the
# Vapi assistant + imports the Twilio number (ops-side, outside this app).
VAPI_API_KEY=
# VAPI_SERVER_SECRET: required for the /voice/vapi/* webhooks to accept
# requests. Set this to the same value configured as the shared secret on
# the Vapi assistant's Server URL / Model config. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
VAPI_SERVER_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Feature flags ---
FEATURE_REGISTRATION_ENABLED=true
FEATURE_MULTI_TENANT_SIGNUP=false
