# Copy to .env and fill in real values. Never commit the real .env file.

# --- Application ---
APP_NAME="Emergency Revenue Recovery System"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=changeme-generate-a-real-64-byte-secret-for-local-dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database ---
DATABASE_URL=postgresql+asyncpg://errs:errs@localhost:5432/errs
# These defaults are sized for local single-worker dev. In production,
# docker-compose.prod.yml runs 4 uvicorn workers, each with its own pool —
# (DATABASE_POOL_SIZE + DATABASE_MAX_OVERFLOW) x worker count must stay
# under Postgres's max_connections (100 by default on postgres:16-alpine).
# 10+20 x 4 workers = 120 > 100, so production should override these to
# something like 5/5 (5+5 x 4 = 40) — see docker-compose.prod.yml.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- Rate limiting ---
# In-memory, per-process (app/infrastructure/security/rate_limiter.py).
# Under multiple uvicorn workers, each worker enforces its own counter, so
# the real ceiling is roughly (limit x worker count).
RATE_LIMIT_DEFAULT_PER_MINUTE=100
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Request limits ---
MAX_REQUEST_BODY_BYTES=1048576

# --- Third-party providers ---
OPENAI_API_KEY=
# The AI Brain runs two model profiles, chosen automatically by the
# conversation's channel (see app/domain/ai/provider.py's AIModelProfile):
#
#   QUALITY  -> text/simulation dashboard. Latency is irrelevant here, so
#               depth is worth paying for.
#   REALTIME -> live Vapi phone calls. Every second is silence the caller
#               hears, so this profile optimises for response time.
#
# Benchmarked 2026-08-12 on one representative emergency prompt; all
# settings below reached the same emergency/create_emergency_ticket
# outcome with structured output intact:
#   gpt-5 (default effort) 19.8-23.3s | gpt-5 low 8.6s | gpt-4.1-mini 3.3s
OPENAI_MODEL=gpt-5
OPENAI_REASONING_EFFORT=low
OPENAI_REALTIME_MODEL=gpt-4.1-mini
# Leave unset: gpt-4.1-mini is not a reasoning model and rejects this.
OPENAI_REALTIME_REASONING_EFFORT=
# Client-level timeout/retry passed straight to the OpenAI SDK.
# 45s (was 20s) because gpt-5 at default effort straddled the old ceiling.
OPENAI_TIMEOUT_SECONDS=45.0
OPENAI_MAX_RETRIES=1
# The realtime profile fails fast instead: on a live call the caller hears
# the whole timeout as silence, and a retry doubles that while
# double-billing a turn the caller has probably already abandoned.
OPENAI_REALTIME_TIMEOUT_SECONDS=15.0
OPENAI_REALTIME_MAX_RETRIES=0
# VAPI_API_KEY/TWILIO_*: only needed by whoever manually configures the
# Vapi assistant + imports the Twilio number (ops-side, outside this app).
VAPI_API_KEY=
# VAPI_SERVER_SECRET: required for the /voice/vapi/* webhooks to accept
# requests. Set this to the same value configured as the shared secret on
# the Vapi assistant's Server URL / Model config. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
VAPI_SERVER_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Emergency notification ---
# Emergency callers are told what the backend can prove, not what the model
# assumes. The assistant may say "a dispatcher has been alerted" only when a
# configured provider accepted the alert; otherwise it says the emergency is
# logged but the alert could not be confirmed, and points the caller at the
# business's own number or the emergency services.
#
#   none     (default) no alerting. Safe, and honest: every emergency call
#            tells the caller the alert could not be confirmed. Fine for a
#            pilot that watches its dispatch queue by hand.
#   webhook  POST the alert as JSON to a URL the team already watches — a
#            Slack or Teams incoming webhook, PagerDuty Events v2, Zapier, or
#            anything else that accepts JSON and answers 2xx. Needs no vendor
#            account of ours and no per-message billing.
#   logging  DEVELOPMENT ONLY. Reports success while notifying nobody, so the
#            app REFUSES TO START with it when ENVIRONMENT=production.
NOTIFICATION_PROVIDER=none
# Per attempt. This runs inside a live voice turn, where every second is
# silence the caller hears — keep it well under the OpenAI timeouts above.
NOTIFICATION_TIMEOUT_SECONDS=5.0
# Total attempts per emergency ticket, across the whole call. A retry only
# fires when an earlier attempt actually failed.
NOTIFICATION_MAX_ATTEMPTS=2
#
# The destination itself is NOT set here — it is per-organization, stored in
# `organization_notification_settings`, because one deployment serves many
# tenants and each has its own on-call channel. A Slack/Teams webhook URL is
# a credential: it is never logged, never placed in an LLM prompt, and never
# returned in a tool result.

# --- Feature flags ---
FEATURE_REGISTRATION_ENABLED=true
FEATURE_MULTI_TENANT_SIGNUP=false
